# Stalkeer Configuration Example
# Copy this file to config.yml and adjust values as needed

database:
  host: localhost
  port: 5432
  user: stalkeer
  password: your_password_here
  dbname: stalkeer
  sslmode: disable

m3u:
  update_interval: 3600  # seconds

  # M3U sources: required, must be a non-empty list. Each entry has a unique
  # 'name' plus its own file_path and download settings. Each source's
  # effective download destination and archive directory automatically get
  # its name inserted as a subdirectory (e.g. archive_dir: ./m3u_playlist
  # becomes ./m3u_playlist/provider-a), so two sources never collide even if
  # their configured paths look the same.
  sources:
    - name: provider-a
      file_path: /path/to/provider-a.m3u
      download:
        enabled: true
        url: "https://provider-a.example.com/playlist.m3u"
        archive_dir: ./m3u_playlist
        retention_count: 5
        max_file_size_mb: 500
        timeout_seconds: 300
        retry_attempts: 3

        # Optional: HTTP authentication
        # auth_username: ""
        # auth_password: ""
    - name: provider-b
      file_path: /path/to/provider-b.m3u
      download:
        enabled: true
        url: "https://provider-b.example.com/playlist.m3u"
        archive_dir: ./m3u_playlist
        retention_count: 5
        max_file_size_mb: 500
        timeout_seconds: 300
        retry_attempts: 3

# File-based filters (can be overridden by runtime filters)
filter:
  group_title:
    include_patterns:
      - "^VOD - Movies"
      - "^Movies HD"
      - "^TV Shows"
      - "^Series"
    exclude_patterns:
      - "Sports"
      - "Podcast"
      - "Radio"
  
  tvg_name:
    include_patterns: []
    exclude_patterns:
      - "Trailer$"
      - "Sample$"

logging:
  format: json  # json or text
  
  # Modular logging configuration (recommended)
  # Control application and database logging independently
  app:
    level: info  # debug, info, warn, error
  database:
    level: warn  # debug, info, warn, error
  
  # Legacy configuration (deprecated)
  # If app/database levels are not set, this fallback will be used
  # level: info

api:
  port: 8080

# Prometheus metrics exposition (optional): serves a GET /metrics endpoint on
# the admin port for an operator's own external monitoring stack to scrape.
# Disabled by default - the port is not opened at all when disabled.
metrics:
  enabled: false
  port: 8081
  path: /metrics

# TMDB integration for metadata enrichment
tmdb:
  enabled: true
  api_key: your_tmdb_api_key_here  # Get from https://www.themoviedb.org/settings/api
  language: en-US  # Language for TMDB metadata (e.g., en-US, fr-FR, es-ES)
  requests_per_second: 4.0  # Max TMDB API requests per second (TMDB limit: ~40/10s). Set to 0 to disable.

# Radarr integration (optional)
radarr:
  enabled: false
  url: http://localhost:7878
  api_key: your_radarr_api_key_here
  sync_interval: 3600  # seconds
  quality_profile_id: 1

# Sonarr integration (optional)
sonarr:
  enabled: false
  url: http://localhost:8989
  api_key: your_sonarr_api_key_here
  sync_interval: 3600  # seconds
  quality_profile_id: 1

# Jellyfin integration (optional): notifies Jellyfin of newly downloaded
# library paths so it can rescan them without waiting for its own periodic scan
jellyfin:
  enabled: false
  url: http://localhost:8096
  api_key: your_jellyfin_api_key_here

# Push notifications (optional): alerts an operator of a failed or broken
# scheduled run (download, process, m3u-download) without requiring anyone to
# check the dashboard or job logs proactively. A successful run with zero
# failures sends nothing.
notifications:
  enabled: false
  ntfy:
    enabled: false
    server_url: https://ntfy.sh
    topic: ""
    auth_token: ""  # Optional: required only for a protected/private ntfy topic

# Download settings
downloads:
  # Fallback base path for movie downloads. When using the radarr command, movie.Path
  # from the Radarr API is used as the authoritative destination (supports multiple root
  # folders). This value is only used when movie.Path is empty.
  movies_path: ./data/downloads/movies
  # Fallback base path for TV show downloads. When using the sonarr command, series.Path
  # from the Sonarr API is used as the authoritative destination (supports multiple root
  # folders configured in Sonarr's Media Management). This value is only used when
  # series.Path is empty.
  tvshows_path: ./data/downloads/tvshows
  temp_dir: ""  # Empty = use OS temp directory, or specify custom path
  max_parallel: 3  # Number of concurrent downloads
  timeout: 600  # Download timeout in seconds (10 minutes)
  retry_attempts: 3  # Number of in-call HTTP sub-retry attempts within a single external download attempt

  # Resume downloads settings
  resume_enabled: true  # Enable resumable downloads
  progress_interval_mb: 10  # Persist progress every N megabytes
  progress_interval_seconds: 30  # Persist progress every N seconds (whichever comes first)
  lock_timeout_minutes: 5  # Consider locks older than this stale (for cleanup)
  # Retry budget for a single download occurrence: counts one increment per full
  # external attempt (a whole Download() call concluding without success),
  # across both the missing-content matcher and the incomplete-download resume
  # path, regardless of internal HTTP sub-retries (retry_attempts above).
  # Reaching this permanently excludes the occurrence from future attempts
  # (same terminal state a manual cancel reaches) until a full media reset.
  max_retry_attempts: 5

  # Unified `download` command scheduler settings
  force_tier_probability: 0.1  # Chance (0-1) of drawing an already-downloaded/upgrade candidate over new content on a given draw
